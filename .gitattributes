# Example of a `.gitattributes` file which reclassifies `.nu` files as Nushell:
*.nu linguist-language=Nushell

# The language fixtures and their golden files pin byte offsets, and some fixtures test CRLF
# line endings: store them byte-for-byte so that `core.autocrlf` never converts them.
crates/nu-parser/tests/fixtures/language/** -text
