=== accept/env-shorthand/multiple.nu
shape shape_internalcall 0..3 "let"
shape shape_vardecl 4..5 "x"
shape shape_int 8..9 "1"
shape shape_string outside the snippet
shape shape_record outside the snippet
shape shape_string 10..13 "FOO"
shape shape_record 13..14 "="
shape shape_string 14..17 "bar"
shape shape_record 17..18 " "
shape shape_string 18..21 "BAZ"
shape shape_record 21..22 "="
shape shape_variable 22..24 "$x"
shape shape_record 24..25 " "
shape shape_string 25..30 "EMPTY"
shape shape_internalcall 32..36 "echo"
shape shape_variable 37..41 "$env"
shape shape_string 42..45 "FOO"
ir main
  # 4 registers, 23 instructions, 14 bytes of data
     0: load-literal           %0, int(1)
     1: store-variable         var #0 "$x", %0 # let
     2: load-literal           %0, empty
     3: drain                  %0
     4: load-literal           %0, empty
     5: load-literal           %0, empty
     6: load-literal           %1, record(capacity = 3)
     7: load-literal           %2, string("FOO")
     8: load-literal           %3, string("bar")
     9: record-insert          %1, %2, %3
    10: load-literal           %2, string("BAZ")
    11: load-variable          %3, var #0 "$x"
    12: record-insert          %1, %2, %3
    13: load-literal           %2, string("EMPTY")
    14: load-literal           %3, string("")
    15: record-insert          %1, %2, %3
    16: load-literal           %2, closure(#1)
    17: push-positional        %1
    18: push-positional        %2
    19: redirect-out           caller
    20: redirect-err           caller
    21: call                   decl "with-env", %0
    22: return                 %0
ir #1
  # 2 registers, 6 instructions, 3 bytes of data
     0: load-env               %1, "FOO"
     1: push-positional        %1
     2: redirect-out           caller
     3: redirect-err           caller
     4: call                   decl "echo", %0
     5: return                 %0
