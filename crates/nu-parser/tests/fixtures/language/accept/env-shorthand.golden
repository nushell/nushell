=== accept/env-shorthand/before-keyword.nu
shape shape_string 0..3 "FOO"
shape shape_record 3..4 "="
shape shape_string 4..7 "BAR"
shape shape_internalcall 8..10 "if"
shape shape_bool 11..16 "false"
shape shape_block 17..19 "{ "
shape shape_int 19..20 "3"
shape shape_block 20..22 " }"
shape shape_keyword 23..27 "else"
shape shape_block 28..30 "{ "
shape shape_int 30..31 "4"
shape shape_block 31..33 " }"
ir main
  # 4 registers, 11 instructions, 6 bytes of data
     0: load-literal           %1, record(capacity = 1)
     1: load-literal           %2, string("FOO")
     2: load-literal           %3, string("BAR")
     3: record-insert          %1, %2, %3
     4: load-literal           %2, closure(#2)
     5: push-positional        %1
     6: push-positional        %2
     7: redirect-out           caller
     8: redirect-err           caller
     9: call                   decl "with-env", %0
    10: return                 %0
ir #2
  # 2 registers, 7 instructions, 0 bytes of data
     0: load-literal           %1, bool(false)
     1: not                    %1
     2: branch-if              %1, 5       # if false
     3: load-literal           %0, int(3)  # label(0)
     4: jump                   6           # end if
     5: load-literal           %0, int(4)  # label(1), from(2:)
     6: return                 %0          # label(2), from(4:)
