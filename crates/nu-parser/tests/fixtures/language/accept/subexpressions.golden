=== accept/subexpressions/multiline-pipeline.nu
shape shape_block 0..6 "(\n    "
shape shape_internalcall 6..8 "ls"
shape shape_pipe 13..14 "|"
shape shape_internalcall 15..22 "sort-by"
shape shape_string 23..31 "modified"
shape shape_flag 32..41 "--reverse"
shape shape_pipe 46..47 "|"
shape shape_internalcall 48..53 "first"
shape shape_int 54..55 "3"
shape shape_block 55..57 "\n)"
ir main
  # 2 registers, 13 instructions, 7 bytes of data
     0: redirect-out           pipe
     1: call                   decl "ls", %0
     2: load-literal           %1, cell-path($.modified)
     3: push-positional        %1
     4: push-flag              "reverse"
     5: redirect-out           pipe
     6: call                   decl "sort-by", %0
     7: load-literal           %1, int(3)
     8: push-positional        %1
     9: redirect-out           caller
    10: redirect-err           caller
    11: call                   decl "first", %0
    12: return                 %0
