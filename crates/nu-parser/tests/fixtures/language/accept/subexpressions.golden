=== accept/subexpressions/as-argument.nu
shape shape_internalcall 0..4 "echo"
shape shape_block 5..6 "("
shape shape_internalcall 6..9 "pwd"
shape shape_block 9..10 ")"
shape shape_block 11..12 "("
shape shape_internalcall 12..14 "ls"
shape shape_pipe 15..16 "|"
shape shape_internalcall 17..23 "length"
shape shape_block 23..24 ")"
ir main
  # 3 registers, 14 instructions, 0 bytes of data
     0: load-literal           %1, empty
     1: redirect-out           value
     2: call                   decl "pwd", %1
     3: load-literal           %2, empty
     4: redirect-out           pipe
     5: call                   decl "ls", %2
     6: redirect-out           value
     7: call                   decl "length", %2
     8: push-positional        %1
     9: push-positional        %2
    10: redirect-out           caller
    11: redirect-err           caller
    12: call                   decl "echo", %0
    13: return                 %0
=== accept/subexpressions/closing-paren-on-own-line.nu
shape shape_internalcall 0..3 "let"
shape shape_vardecl 4..5 "n"
shape shape_block 8..12 "(\n  "
shape shape_int 12..13 "1"
shape shape_operator 14..15 "+"
shape shape_int 16..17 "2"
shape shape_block 17..19 "\n)"
ir main
  # 2 registers, 7 instructions, 0 bytes of data
     0: load-literal           %0, int(1)
     1: load-literal           %1, int(2)
     2: binary-op              %0, Math(Add), %1
     3: span                   %0
     4: store-variable         var #0 "$n", %0 # let
     5: load-literal           %0, empty
     6: return                 %0
