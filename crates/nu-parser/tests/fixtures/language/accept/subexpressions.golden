shape shape_block 36..37 "("
shape shape_record 37..47 "{\n        "
shape shape_string 47..52 "\"200\""
shape shape_record 52..54 ": "
shape shape_string 54..57 "\"x\""
shape shape_record 57..64 ",\n    }"
shape shape_block 64..65 ")"
shape shape_closure 65..67 "\n}"
ir main
  # 1 register, 2 instructions, 0 bytes of data
     0: load-literal           %0, empty
     1: return                 %0
ir #2
  # 3 registers, 7 instructions, 4 bytes of data
     0: load-literal           %0, record(capacity = 1)
     1: load-literal           %1, string("200")
     2: load-literal           %2, string("x")
     3: record-insert          %0, %1, %2
     4: store-variable         var #0, %0  # let
     5: load-literal           %0, empty
     6: return                 %0
