    50: redirect-out           file(3)
    51: redirect-err           caller
    52: call                   decl "run-external", %0
    53: write-file             file(3), %0
    54: load-literal           %0, empty
    55: close-file             file(3)
    56: return                 %0
=== accept/redirections/then-pipe.nu
shape shape_external 1..3 "ls"
shape shape_redirection 4..6 "e>"
shape shape_string 7..16 "/dev/null"
shape shape_pipe 17..18 "|"
shape shape_internalcall 19..24 "lines"
ir main
  # 2 registers, 12 instructions, 11 bytes of data
  # 1 file used for redirection
     0: load-literal           %1, string("/dev/null")
     1: open-file              file(0), %1, append = false
     2: load-literal           %1, glob-pattern("ls", no_expand = false)
     3: push-positional        %1
     4: redirect-out           pipe
     5: redirect-err           file(0)
     6: call                   decl "run-external", %0
     7: close-file             file(0)
     8: redirect-out           caller
     9: redirect-err           caller
    10: call                   decl "lines", %0
    11: return                 %0
