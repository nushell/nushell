shape shape_list 50..51 "]"
ir main
  # 2 registers, 17 instructions, 11 bytes of data
     0: load-literal           %0, string("ünïcödé")
     1: store-variable         var #0 "$🧼", %0 # let
     2: load-literal           %0, empty
     3: drain                  %0
     4: load-literal           %0, empty
     5: load-literal           %0, empty
     6: load-literal           %0, int(1)
     7: store-variable         var #1 "$üml", %0 # let
     8: load-literal           %0, empty
     9: drain                  %0
    10: load-literal           %0, empty
    11: load-literal           %0, list(capacity = 2)
    12: load-variable          %1, var #0 "$🧼"
    13: list-push              %0, %1
    14: load-variable          %1, var #1 "$üml"
    15: list-push              %0, %1
    16: return                 %0
