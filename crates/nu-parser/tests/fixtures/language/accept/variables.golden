=== accept/variables/underscore-and-digits.nu
shape shape_internalcall 0..3 "let"
shape shape_vardecl 4..8 "_x_1"
shape shape_int 11..12 "1"
shape shape_internalcall 13..16 "let"
shape shape_vardecl 17..19 "__"
shape shape_int 22..23 "2"
shape shape_variable 24..29 "$_x_1"
shape shape_operator 30..31 "+"
shape shape_variable 32..35 "$__"
ir main
  # 2 registers, 16 instructions, 0 bytes of data
     0: load-literal           %0, int(1)
     1: store-variable         var #0 "$_x_1", %0 # let
     2: load-literal           %0, empty
     3: drain                  %0
     4: load-literal           %0, empty
     5: load-literal           %0, empty
     6: load-literal           %0, int(2)
     7: store-variable         var #1 "$__", %0 # let
     8: load-literal           %0, empty
     9: drain                  %0
    10: load-literal           %0, empty
    11: load-variable          %0, var #0 "$_x_1"
    12: load-variable          %1, var #1 "$__"
    13: binary-op              %0, Math(Add), %1
    14: span                   %0
    15: return                 %0
=== accept/variables/unicode-name.nu
