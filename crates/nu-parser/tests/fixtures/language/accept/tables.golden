=== accept/tables/variable-column.nu
shape shape_internalcall 0..3 "let"
shape shape_vardecl 4..15 "column_name"
shape shape_string 18..27 "'column0'"
shape shape_internalcall 28..31 "let"
shape shape_vardecl 32..35 "tbl"
shape shape_table 38..41 "[[ "
shape shape_variable 41..53 "$column_name"
shape shape_table 53..54 " "
shape shape_string 54..61 "column1"
shape shape_table 61..67 " ]; [ "
shape shape_string 67..70 "foo"
shape shape_table 70..71 " "
shape shape_string 71..74 "bar"
shape shape_table 74..79 " ] [ "
shape shape_string 79..82 "baz"
shape shape_table 82..83 " "
shape shape_string 83..86 "car"
shape shape_table 86..91 " ] [ "
shape shape_string 91..94 "far"
shape shape_table 94..95 " "
shape shape_string 95..98 "fit"
shape shape_table 98..101 " ]]"
shape shape_variable 102..106 "$tbl"
shape shape_string 107..114 "column0"
shape shape_int 115..116 "0"
ir main
  # 6 registers, 43 instructions, 32 bytes of data
     0: load-literal           %0, string("column0")
     1: store-variable         var #0 "$column_name", %0 # let
     2: load-literal           %0, empty
     3: drain                  %0
     4: load-literal           %0, empty
     5: load-literal           %0, empty
     6: load-literal           %0, list(capacity = 3)
     7: load-variable          %1, var #0 "$column_name"
     8: load-literal           %2, string("column1")
     9: load-literal           %3, record(capacity = 2)
    10: clone                  %4, %1
    11: load-literal           %5, string("foo")
    12: record-insert          %3, %4, %5
    13: clone                  %4, %2
    14: load-literal           %5, string("bar")
    15: record-insert          %3, %4, %5
    16: list-push              %0, %3
    17: load-literal           %3, record(capacity = 2)
    18: clone                  %4, %1
    19: load-literal           %5, string("baz")
    20: record-insert          %3, %4, %5
    21: clone                  %4, %2
    22: load-literal           %5, string("car")
    23: record-insert          %3, %4, %5
    24: list-push              %0, %3
    25: load-literal           %3, record(capacity = 2)
    26: clone                  %4, %1
    27: load-literal           %5, string("far")
    28: record-insert          %3, %4, %5
    29: clone                  %4, %2
    30: load-literal           %5, string("fit")
    31: record-insert          %3, %4, %5
    32: list-push              %0, %3
    33: drop                   %1
    34: drop                   %2
    35: store-variable         var #1 "$tbl", %0 # let
    36: load-literal           %0, empty
    37: drain                  %0
    38: load-literal           %0, empty
    39: load-variable          %0, var #1 "$tbl"
    40: load-literal           %1, cell-path($."column0".0)
    41: follow-cell-path       %0, %1
    42: return                 %0
