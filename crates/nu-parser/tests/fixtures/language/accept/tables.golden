=== accept/tables/basic.nu
shape shape_table 0..2 "[["
shape shape_string 2..3 "a"
shape shape_table 3..4 " "
shape shape_string 4..5 "b"
shape shape_table 5..9 "]; ["
shape shape_int 9..10 "1"
shape shape_table 10..11 " "
shape shape_int 11..12 "2"
shape shape_table 12..15 "] ["
shape shape_int 15..16 "3"
shape shape_table 16..17 " "
shape shape_int 17..18 "4"
shape shape_table 18..20 "]]"
ir main
  # 6 registers, 22 instructions, 2 bytes of data
     0: load-literal           %0, list(capacity = 2)
     1: load-literal           %1, string("a")
     2: load-literal           %2, string("b")
     3: load-literal           %3, record(capacity = 2)
     4: clone                  %4, %1
     5: load-literal           %5, int(1)
     6: record-insert          %3, %4, %5
     7: clone                  %4, %2
     8: load-literal           %5, int(2)
     9: record-insert          %3, %4, %5
    10: list-push              %0, %3
    11: load-literal           %3, record(capacity = 2)
    12: clone                  %4, %1
    13: load-literal           %5, int(3)
    14: record-insert          %3, %4, %5
    15: clone                  %4, %2
    16: load-literal           %5, int(4)
    17: record-insert          %3, %4, %5
    18: list-push              %0, %3
    19: drop                   %1
    20: drop                   %2
    21: return                 %0
=== accept/tables/bool-columns.nu
shape shape_table 0..2 "[["
shape shape_string 2..3 "a"
shape shape_table 3..5 ", "
shape shape_string 5..6 "b"
shape shape_table 6..10 "]; ["
shape shape_bool 10..14 "true"
shape shape_table 14..16 ", "
shape shape_bool 16..21 "false"
shape shape_table 21..25 "], ["
shape shape_bool 25..29 "true"
shape shape_table 29..31 ", "
shape shape_bool 31..35 "true"
shape shape_table 35..37 "]]"
shape shape_pipe 38..39 "|"
shape shape_internalcall 40..45 "where"
shape shape_string 46..47 "a"
shape shape_variable 46..47 "a"
shape shape_pipe 48..49 "|"
shape shape_internalcall 50..56 "length"
ir main
  # 6 registers, 29 instructions, 2 bytes of data
     0: load-literal           %0, list(capacity = 2)
     1: load-literal           %1, string("a")
     2: load-literal           %2, string("b")
     3: load-literal           %3, record(capacity = 2)
     4: clone                  %4, %1
     5: load-literal           %5, bool(true)
     6: record-insert          %3, %4, %5
     7: clone                  %4, %2
     8: load-literal           %5, bool(false)
     9: record-insert          %3, %4, %5
    10: list-push              %0, %3
    11: load-literal           %3, record(capacity = 2)
    12: clone                  %4, %1
    13: load-literal           %5, bool(true)
    14: record-insert          %3, %4, %5
    15: clone                  %4, %2
    16: load-literal           %5, bool(true)
    17: record-insert          %3, %4, %5
    18: list-push              %0, %3
    19: drop                   %1
    20: drop                   %2
    21: load-literal           %1, row_condition(#0)
    22: push-positional        %1
    23: redirect-out           pipe
    24: call                   decl "where", %0
    25: redirect-out           caller
    26: redirect-err           caller
    27: call                   decl "length", %0
    28: return                 %0
=== accept/tables/cell-path-column-name.nu
shape shape_table 0..4 "[[$."
shape shape_string 4..5 "a"
shape shape_table 5..9 "]; ["
shape shape_int 9..10 "1"
shape shape_table 10..12 "]]"
ir main
  # 5 registers, 9 instructions, 0 bytes of data
     0: load-literal           %0, list(capacity = 1)
     1: load-literal           %1, cell-path($.a)
     2: load-literal           %2, record(capacity = 1)
     3: clone                  %3, %1
     4: load-literal           %4, int(1)
     5: record-insert          %2, %3, %4
     6: list-push              %0, %2
     7: drop                   %1
     8: return                 %0
