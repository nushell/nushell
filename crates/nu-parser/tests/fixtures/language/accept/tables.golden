=== accept/tables/multiline.nu
shape shape_table 0..2 "[["
shape shape_string 2..6 "name"
shape shape_table 6..7 " "
shape shape_string 7..11 "size"
shape shape_table 11..17 "];\n  ["
shape shape_string 17..20 "\"a\""
shape shape_table 20..21 " "
shape shape_int 21..22 "1"
shape shape_string 22..24 "kb"
shape shape_table 24..29 "]\n  ["
shape shape_string 29..32 "\"b\""
shape shape_table 32..33 " "
shape shape_int 33..36 "2.5"
shape shape_string 36..38 "mb"
shape shape_table 38..41 "]\n]"
ir main
  # 6 registers, 22 instructions, 10 bytes of data
     0: load-literal           %0, list(capacity = 2)
     1: load-literal           %1, string("name")
     2: load-literal           %2, string("size")
     3: load-literal           %3, record(capacity = 2)
     4: clone                  %4, %1
     5: load-literal           %5, string("a")
     6: record-insert          %3, %4, %5
     7: clone                  %4, %2
     8: load-literal           %5, filesize(1 kBb)
     9: record-insert          %3, %4, %5
    10: list-push              %0, %3
    11: load-literal           %3, record(capacity = 2)
    12: clone                  %4, %1
    13: load-literal           %5, string("b")
    14: record-insert          %3, %4, %5
    15: clone                  %4, %2
    16: load-literal           %5, filesize(2.5 MBb)
    17: record-insert          %3, %4, %5
    18: list-push              %0, %3
    19: drop                   %1
    20: drop                   %2
    21: return                 %0
=== accept/tables/nested-values.nu
shape shape_table 0..2 "[["
shape shape_string 2..3 "a"
shape shape_table 3..4 " "
shape shape_string 4..5 "b"
shape shape_table 5..9 "]; ["
shape shape_record 9..10 "{"
shape shape_string 10..11 "x"
shape shape_record 11..13 ": "
shape shape_int 13..14 "1"
shape shape_record 14..15 "}"
shape shape_table 15..16 " "
shape shape_list 16..17 "["
shape shape_int 17..18 "1"
shape shape_list 18..19 " "
shape shape_int 19..20 "2"
shape shape_list 20..21 "]"
shape shape_table 21..24 "] ["
shape shape_block 24..25 "("
shape shape_int 25..26 "1"
shape shape_operator 27..28 "+"
shape shape_int 29..30 "1"
shape shape_block 30..31 ")"
shape shape_table 31..32 " "
shape shape_string_interpolation 32..34 "$\""
shape shape_string 34..35 "s"
shape shape_block 35..36 "("
shape shape_int 36..37 "1"
shape shape_block 37..38 ")"
shape shape_string_interpolation 38..39 "\""
shape shape_table 39..41 "]]"
ir main
  # 8 registers, 34 instructions, 4 bytes of data
     0: load-literal           %0, list(capacity = 2)
     1: load-literal           %1, string("a")
     2: load-literal           %2, string("b")
     3: load-literal           %3, record(capacity = 2)
     4: clone                  %4, %1
     5: load-literal           %5, record(capacity = 1)
     6: load-literal           %6, string("x")
     7: load-literal           %7, int(1)
     8: record-insert          %5, %6, %7
     9: record-insert          %3, %4, %5
    10: clone                  %4, %2
    11: load-literal           %5, list(capacity = 2)
    12: load-literal           %6, int(1)
    13: list-push              %5, %6
    14: load-literal           %6, int(2)
    15: list-push              %5, %6
    16: record-insert          %3, %4, %5
    17: list-push              %0, %3
    18: load-literal           %3, record(capacity = 2)
    19: clone                  %4, %1
    20: load-literal           %5, int(1)
    21: load-literal           %6, int(1)
    22: binary-op              %5, Math(Add), %6
    23: span                   %5
    24: record-insert          %3, %4, %5
    25: clone                  %4, %2
    26: load-literal           %5, string("s")
    27: load-literal           %6, int(1)
    28: string-append          %5, %6
    29: record-insert          %3, %4, %5
    30: list-push              %0, %3
    31: drop                   %1
    32: drop                   %2
    33: return                 %0
=== accept/tables/no-rows-is-list.nu
shape shape_list 0..1 "["
shape shape_list 1..2 "["
shape shape_string 2..3 "a"
shape shape_list 3..4 " "
shape shape_string 4..5 "b"
shape shape_list 5..6 "]"
shape shape_list 6..7 "]"
ir main
  # 3 registers, 8 instructions, 2 bytes of data
     0: load-literal           %0, list(capacity = 1)
     1: load-literal           %1, list(capacity = 2)
     2: load-literal           %2, string("a")
     3: list-push              %1, %2
     4: load-literal           %2, string("b")
     5: list-push              %1, %2
     6: list-push              %0, %1
     7: return                 %0
