=== accept/closures/as-argument-to-each-with-flag.nu
shape shape_block 0..1 "("
shape shape_list 1..2 "["
shape shape_string 2..3 "a"
shape shape_list 3..5 ", "
shape shape_string 5..6 "b"
shape shape_list 6..8 ", "
shape shape_string 8..9 "c"
shape shape_list 9..10 "]"
shape shape_pipe 11..12 "|"
shape shape_internalcall 13..22 "enumerate"
shape shape_pipe 23..24 "|"
shape shape_internalcall 25..29 "each"
shape shape_flag 30..42 "--keep-empty"
shape shape_closure 43..49 "{ |e| "
shape shape_internalcall 49..51 "if"
shape shape_variable 52..54 "$e"
shape shape_string 55..60 "index"
shape shape_operator 61..63 "!="
shape shape_int 64..65 "1"
shape shape_block 66..68 "{ "
shape shape_int 68..71 "100"
shape shape_block 71..73 " }"
shape shape_closure 73..74 "}"
shape shape_block 74..75 ")"
shape shape_int 76..77 "1"
ir main
  # 2 registers, 17 instructions, 13 bytes of data
     0: load-literal           %0, list(capacity = 3)
     1: load-literal           %1, string("a")
     2: list-push              %0, %1
     3: load-literal           %1, string("b")
     4: list-push              %0, %1
     5: load-literal           %1, string("c")
     6: list-push              %0, %1
     7: redirect-out           pipe
     8: call                   decl "enumerate", %0
     9: load-literal           %1, closure(#1)
    10: push-flag              "keep-empty"
    11: push-positional        %1
    12: redirect-out           value
    13: call                   decl "each", %0
    14: load-literal           %1, cell-path($.1)
    15: follow-cell-path       %0, %1
    16: return                 %0
ir #1
  # 3 registers, 12 instructions, 0 bytes of data
     0: load-variable          %1, var #0
     1: load-literal           %2, cell-path($.index)
     2: follow-cell-path       %1, %2
     3: load-literal           %2, int(1)
     4: binary-op              %1, Comparison(NotEqual), %2
     5: span                   %1
     6: not                    %1
     7: branch-if              %1, 10      # if false
     8: load-literal           %0, int(100) # label(0)
     9: jump                   11          # end if
    10: load-literal           %0, empty   # label(1), from(7:)
    11: return                 %0          # label(2), from(9:)
