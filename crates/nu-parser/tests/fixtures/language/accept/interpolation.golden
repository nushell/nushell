=== accept/interpolation/unicode-escape-and-subexpr.nu
shape shape_string_interpolation 0..2 "$\""
shape shape_string 2..10 "\\u{015B}"
shape shape_block 10..11 "("
shape shape_internalcall 11..15 "char"
shape shape_string 16..25 "hamburger"
shape shape_block 25..26 ")"
shape shape_string 26..29 "abc"
shape shape_string_interpolation 29..30 "\""
ir main
  # 3 registers, 10 instructions, 14 bytes of data
     0: load-literal           %0, string("ś")
     1: load-literal           %1, empty
     2: load-literal           %2, string("hamburger")
     3: push-positional        %2
     4: redirect-out           value
     5: call                   decl "char", %1
     6: string-append          %0, %1
     7: load-literal           %1, string("abc")
     8: string-append          %0, %1
     9: return                 %0
=== accept/interpolation/with-equals.nu
shape shape_internalcall 0..3 "let"
shape shape_vardecl 4..16 "query_prefix"
shape shape_string_interpolation 19..21 "$\""
shape shape_string 21..73 "https://api.github.com/search/issues?q=repo:nushell/"
shape shape_string_interpolation 73..74 "\""
shape shape_variable 75..88 "$query_prefix"
ir main
  # 1 register, 7 instructions, 52 bytes of data
     0: load-literal           %0, string("https://api.github.com/search/issues?q=repo:nushell/")
     1: store-variable         var #0 "$query_prefix", %0 # let
     2: load-literal           %0, empty
     3: drain                  %0
     4: load-literal           %0, empty
     5: load-variable          %0, var #0 "$query_prefix"
     6: return                 %0
