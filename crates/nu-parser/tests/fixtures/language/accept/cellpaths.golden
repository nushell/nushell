shape shape_vardecl 4..5 "x"
shape shape_record 8..9 "{"
shape shape_string 9..15 "héllo"
shape shape_record 15..17 ": "
shape shape_int 17..18 "1"
shape shape_record 18..19 "}"
shape shape_variable 20..22 "$x"
shape shape_string 23..29 "héllo"
ir main
  # 3 registers, 12 instructions, 6 bytes of data
     0: load-literal           %0, record(capacity = 1)
     1: load-literal           %1, string("héllo")
     2: load-literal           %2, int(1)
     3: record-insert          %0, %1, %2
     4: store-variable         var #0 "$x", %0 # let
     5: load-literal           %0, empty
     6: drain                  %0
     7: load-literal           %0, empty
     8: load-variable          %0, var #0 "$x"
     9: load-literal           %1, cell-path($.héllo)
    10: follow-cell-path       %0, %1
    11: return                 %0
